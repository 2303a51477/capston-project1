# ========================================================
# Google Gemini API & Database Configuration (Template)
# Copy this file to .env and insert your real Gemini API key
# ========================================================

# Google Gemini API Key
# Sign up and get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model
# Options: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.8-flash, gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Connection URI
# Local MongoDB or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017/student_ai_chatbot
# e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/student_ai_chatbot
MONGO_URI=mongodb://localhost:27017/student_ai_chatbot

# Flask Application Secret Key
SECRET_KEY=ai-student-perf-pred-secure-key-2026
